<% layout("/layouts/boilerplate") %>

<body>
  
    <div class="row">
    <div class="col-8 offset-2">
   
<h3>Create a new listing</h3>
 <br/><br/>

<form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

    <!-- Title -->
    <div class="mb-3">
       <label for="title" class="form-label" >Title</label>
       <input type="text" name="listing[title]" placeholder="Enter title" class="form-control" required  />
   
    <div class="valid-feedback">
      Looks good!
    </div>
     </div>

    <!-- Description -->
    <div class="mb-3">
       <label for="description" class="form-label" >Description</label>
       <textarea name="listing[description]" placeholder="Enter description" class="form-control" required></textarea>
      
    </div>
    <div class="valid-feedback">
      Looks good!
    </div>

    <!-- Image -->
       <div class="row">
        <div class="mb-3">
        <label class="form-label">Upload listing image</label>
         <input name="listing[image]" type="file" class="form-control" />
      </div>

   
    <!-- Price -->
    <div class="mb-3 col-4">
        <label for="price" class="form-label" >Price</label>
        <input name="listing[price]" placeholder="Price" class="form-control" required>   
      <div class="invalid-feedback">
     please! enter a valid price 
       </div>
    </div>

    <!-- Country -->
    <div class="mb-3 col-8">
        <label for="country" class="form-label" >Country</label>
        <input type="text" name="listing[country]" placeholder="Country" class="form-control" required/>
        <div class="invalid-feedback">
     country should be valid
    </div>
    </div>
 
    
    <!-- Location -->
    <div class="mb-3">
        <label for="location" class="form-label" >Location</label>
        <input type="text" name="listing[location]" placeholder="Location" class="form-control" required/>
        <div class="invalid-feedback">
       enter a correct location
    </div>
    </div>
    <br>
    <button class="btn btn-dark add-btn">Add</button>

</form>
    </div>
    </div>
  
  
</body>

