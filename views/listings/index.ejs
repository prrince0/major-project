           <div class="card-body">
               <p class="card-text">
                 <b><%= listing.title %></b><br> ₹<%= listing.price.toLocaleString("en-IN") %> /night 
                 <i class="tax-info">&nbsp;+20% taxes</i>
                 </i>
                </p> 
               
